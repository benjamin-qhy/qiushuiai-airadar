{
  "name": "@airadar/cli",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "bin": {
    "airadar": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "web",
    "config",
    "prompts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/build-cli.mjs && node ../../scripts/copy-web-assets.mjs",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@airadar/config": "workspace:*",
    "@airadar/service": "workspace:*",
    "@airadar/web": "workspace:*"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
