{
  "name": "@airadar/cli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "airadar": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "web"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/cli.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/cli.js && node ../../scripts/copy-web-assets.mjs",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@airadar/config": "workspace:*",
    "@airadar/service": "workspace:*",
    "@airadar/web": "workspace:*"
  }
}
