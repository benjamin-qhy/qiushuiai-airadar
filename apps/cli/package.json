{
  "name": "@airadar/cli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "airadar": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@airadar/config": "workspace:*",
    "@airadar/service": "workspace:*"
  }
}
