{
  "name": "@qiushuiai-airadar/service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@qiushuiai-airadar/config": "workspace:*",
    "@qiushuiai-airadar/pipeline": "workspace:*",
    "@qiushuiai-airadar/runtime": "workspace:*",
    "@qiushuiai-airadar/source-adapters": "workspace:*"
  }
}
